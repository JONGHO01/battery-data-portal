# Local development example.
# Copy to .env only on your computer. Do not commit the real .env file.

APP_ENV=local
PORT=4173
MAX_UPLOAD_BYTES=104857600

# Local mode uses SQLite. Render/Fly/Railway should provide DATABASE_URL.
DATABASE_URL=
SQLITE_DB=

# Change this before a real deployment. Header authentication is disabled by default.
JWT_SECRET=local-dev-change-before-deploy
ALLOW_LEGACY_USER_HEADER=false
CORS_ALLOW_ORIGINS=
BOOTSTRAP_ADMIN_ID=qq035786
BOOTSTRAP_ADMIN_NAME=원종호
BOOTSTRAP_ADMIN_PASSWORD=

# A second administrator confirmation is required before raw Dataset rows can
# be browsed. Set the real value only in the ignored local .env or Render.
ADMIN_RAW_DATA_PASSWORD=
ADMIN_RAW_DATA_TTL_SECONDS=600

# For local testing keep files under data/uploads.
# For a real site set STORAGE_BACKEND=supabase or STORAGE_BACKEND=s3 and
# REQUIRE_DURABLE_STORAGE=true. Do not use local storage in production.
STORAGE_BACKEND=local
REQUIRE_DURABLE_STORAGE=false
DATA_DIR=
# Backblaze B2 uses the S3-compatible API. Copy the exact region and endpoint
# shown for the private bucket; never commit real credentials.
S3_PROVIDER=b2
S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_ENDPOINT_URL=https://s3.<B2_REGION>.backblazeb2.com
S3_REGION=<B2_REGION>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# In PostgreSQL production, keep only Dataset metadata and row counts in Neon.
# Full normalized rows and raw files remain in the private S3-compatible bucket.
DATABASE_ROWS_MODE=artifact
MAX_OBJECT_ARTIFACT_BYTES=268435456

# Use one long random value in both Render and the local Windows backup task.
# The agent receives short-lived download URLs; it never receives B2 credentials.
ARCHIVE_AGENT_TOKEN=
ARCHIVE_DOWNLOAD_TTL_SECONDS=900
ARCHIVE_SOFT_LIMIT_BYTES=8589934592
ARCHIVE_HARD_LIMIT_BYTES=9663676416

# Real AI summary. Leave OPENAI_API_KEY blank to use local rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
