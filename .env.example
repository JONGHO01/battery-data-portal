# Local development example.
# Copy to .env only on your computer. Do not commit the real .env file.

APP_ENV=local
PORT=4173
MAX_UPLOAD_BYTES=104857600

# Local mode uses SQLite. Render/Fly/Railway should provide DATABASE_URL.
DATABASE_URL=
SQLITE_DB=

# Change this before a real deployment. Header authentication is disabled by default.
JWT_SECRET=local-dev-change-before-deploy
ALLOW_LEGACY_USER_HEADER=false
CORS_ALLOW_ORIGINS=
BOOTSTRAP_ADMIN_ID=qq035786
BOOTSTRAP_ADMIN_NAME=원종호
BOOTSTRAP_ADMIN_PASSWORD=

# For local testing keep files under data/uploads.
# For a real site set STORAGE_BACKEND=supabase or STORAGE_BACKEND=s3 and
# REQUIRE_DURABLE_STORAGE=true. Do not use local storage in production.
STORAGE_BACKEND=local
REQUIRE_DURABLE_STORAGE=false
DATA_DIR=
S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Real AI summary. Leave OPENAI_API_KEY blank to use local rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
