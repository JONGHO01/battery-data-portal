{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Battery Data Portal",
      "runtimeExecutable": "${env:USERPROFILE}\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\node\\bin\\node.exe",
      "program": "${workspaceFolder}\\server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "4173"
      },
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
