{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Battery Data Portal",
      "type": "process",
      "command": "${env:USERPROFILE}\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe",
      "args": [
        "python_backend.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "4173",
          "DATA_DIR": "${workspaceFolder}\\data",
          "JWT_SECRET": "local-dev-change-before-deploy",
          "ALLOW_LEGACY_USER_HEADER": "true"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Check JavaScript Syntax",
      "type": "process",
      "command": "${env:USERPROFILE}\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\node\\bin\\node.exe",
      "args": [
        "--check",
        "public/app.js"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Check Python Syntax",
      "type": "process",
      "command": "${env:USERPROFILE}\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe",
      "args": [
        "-m",
        "py_compile",
        "python_backend.py",
        "start_local_server.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
